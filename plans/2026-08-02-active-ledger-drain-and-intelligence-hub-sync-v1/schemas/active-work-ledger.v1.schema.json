{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "active-work-ledger.v1.schema.json",
  "title": "Active Work Ledger Export",
  "description": "Full structured export of ACTIVE_WORK.md — explicit retrieval only; not default preflight injection.",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceRepository",
    "sourcePath",
    "sourceCommitSha",
    "generatedAt",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "sourceRepository": { "type": "string", "const": "CapitalGlass-Cross-Agent" },
    "sourcePath": { "type": "string", "const": "work-progress/ACTIVE_WORK.md" },
    "sourceCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "workPackageId": { "type": "string" },
    "currentStatus": { "type": "object" },
    "savedWork": { "type": "array" },
    "openActions": { "type": "array" },
    "blockers": { "type": "array" },
    "authorityRules": { "type": "array" },
    "projectPointers": { "type": "array" },
    "drainReceipt": { "type": "object" }
  },
  "additionalProperties": false
}
