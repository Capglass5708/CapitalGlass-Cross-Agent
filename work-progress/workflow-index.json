    {
      "workflowId": "wf-hot-cache-dataset-compile-v1",
      "displayName": "Hot-cache dataset compile",
      "ownerRepo": "CG-AppBuilder-MCP",
      "purpose": "Compile a registered hot-cache dataset index from Cross-Agent manifest inputs without publishing.",
      "entryCommandIds": [
        "hot-cache-compile-dataset",
        "git-estate-compile-index",
        "active-ledger-compile-index",
        "command-estate-compile-index",
        "workflow-estate-compile-index",
        "prompt-catalog-compile-index"
      ],
      "preconditions": ["CROSS_AGENT_ROOT set", "dataset registered in hot-cache-dataset-registry"],
      "requiredApprovals": [],
      "mutationScope": "read-only compile outputs under runtime/<datasetId>/",
      "allowedMachines": ["WESLEY_WORK", "WESLEYDESK"],
      "inputAuthorities": ["registry/datasets/hot-cache-dataset-registry.v1.json", "registry/*/manifest"],
      "outputArtifacts": ["runtime/<datasetId>/*.latest.json"],
      "acceptanceGates": ["*_COMPILE_PASS"],
