      "failureClassifications": ["HOT_CACHE_ROOT_MISSING", "STALE_COMPILE_ARTIFACT"],
      "rollbackWorkflowId": "wf-hot-cache-dataset-compile-v1",
      "receiptContract": "hot-cache-publication-generation-v1",
      "relatedDatasetIds": ["active-ledger", "closeout-index", "command-estate", "prompt-catalog", "receipt-registry"]
    },
    {
      "workflowId": "wf-l-by-kind-publication-v1",
