      "rollbackWorkflowId": null,
      "receiptContract": "hot-cache-compile-receipt-v1",
      "relatedDatasetIds": ["git-estate", "active-ledger", "command-estate", "workflow-estate", "prompt-catalog"]
    },
    {
      "workflowId": "wf-hot-cache-local-publication-v1",
      "displayName": "Hot-cache local publication",
      "ownerRepo": "CG-AppBuilder-MCP",
      "purpose": "Publish compiled hot-cache dataset generations to host-local authority cache root.",
      "entryCommandIds": [
        "active-ledger-publish-hot-cache",
        "closeout-index-publish-hot-cache",
        "command-estate-publish-hot-cache",
        "prompt-catalog-publish-hot-cache",
        "intelligence-hub-publish-hot-routing-index"
