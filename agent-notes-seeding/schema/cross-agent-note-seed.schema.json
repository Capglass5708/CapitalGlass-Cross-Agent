{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capitalglass.dev/schemas/cross-agent-note-seed.v1.json",
  "title": "Cross-Agent Note Seed Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "seedId",
    "source",
    "classification",
    "canonicalOwner",
    "lifecycle"
  ],
  "properties": {
    "seedId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*-v[0-9]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "section", "commitSha", "contentHash"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 },
        "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "known_failure",
        "active_action",
        "reusable_knowledge",
        "authority_decision",
        "reference_only"
      ]
    },
    "canonicalOwner": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "additionalProperties": true
    },
    "triggers": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "failureCodes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hosts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "workPackages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "repoKeys": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "lifecycle": {
      "type": "string",
      "enum": ["candidate", "promoted", "revoked", "stale"]
    },
    "rejectedApproachIds": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "classification": { "const": "known_failure" } } },
      "then": {
        "required": ["target", "triggers"],
        "properties": {
          "target": {
            "required": ["system", "recordId", "shortcutId"],
            "properties": {
              "system": { "const": "failure-intelligence" },
              "recordId": { "type": "string", "minLength": 1 },
              "shortcutId": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "classification": { "const": "reference_only" } } },
      "then": {
        "not": { "required": ["target"] }
      }
    }
  ]
}
