{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capitalglass.dev/schemas/cross-agent-thread-autopsy-bundle-v1.json",
  "title": "Cross-Agent Thread Autopsy Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "harvestId",
    "tier",
    "wasteLedgerStatus",
    "waste",
    "operatorFriction",
    "executionDeltas",
    "wrongMoves",
    "duplicateWork",
    "roiBacklog",
    "doNotAdvanceMap",
    "duplicationCheck"
  ],
  "properties": {
    "schemaVersion": { "const": "cross-agent-thread-autopsy-bundle-v1@1.0.0" },
    "harvestId": { "type": "string", "minLength": 1 },
    "tier": { "enum": ["T0", "T1", "T2", "T3"] },
    "wasteLedgerStatus": { "enum": ["POPULATED", "NONE_FOUND"] },
    "noneFoundEvidence": { "type": "string" },
    "noDeltaReason": { "type": "string" },
    "waste": {
      "type": "array",
      "items": { "$ref": "#/$defs/wasteEntry" }
    },
    "operatorFriction": {
      "type": "array",
      "items": { "$ref": "#/$defs/operatorFrictionEntry" }
    },
    "executionDeltas": {
      "type": "array",
      "items": { "$ref": "#/$defs/executionDelta" }
    },
    "wrongMoves": {
      "type": "array",
      "items": { "$ref": "#/$defs/wrongMove" }
    },
    "duplicateWork": {
      "type": "array",
      "items": { "$ref": "#/$defs/duplicateWork" }
    },
    "roiBacklog": {
      "type": "array",
      "items": { "$ref": "#/$defs/roiItem" }
    },
    "doNotAdvanceMap": {
      "type": "array",
      "items": { "$ref": "#/$defs/doNotAdvanceEntry" }
    },
    "duplicationCheck": { "$ref": "#/$defs/duplicationCheck" }
  },
  "$defs": {
    "wasteEntry": {
      "type": "object",
      "required": ["wasteId", "type", "description", "estimatedImpact", "savedBy"],
      "properties": {
        "wasteId": { "type": "string" },
        "type": {
          "enum": [
            "retrieval",
            "context",
            "tool",
            "host",
            "agent",
            "deploy",
            "verification",
            "rework",
            "operator_attention"
          ]
        },
        "description": { "type": "string" },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } },
        "estimatedImpact": { "enum": ["low", "medium", "high"] },
        "savedBy": { "type": "string" },
        "roiRank": { "type": "integer", "minimum": 1 }
      }
    },
    "operatorFrictionEntry": {
      "type": "object",
      "required": ["frictionId", "trigger", "operatorCost", "systemFix"],
      "properties": {
        "frictionId": { "type": "string" },
        "trigger": { "type": "string" },
        "operatorCost": { "enum": ["low", "medium", "high"] },
        "frequency": { "type": "string" },
        "systemFix": { "type": "string" },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } },
        "linkedWasteIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "executionDelta": {
      "type": "object",
      "required": ["executionDeltaId", "situation", "actualExecution", "optimalExecution"],
      "properties": {
        "executionDeltaId": { "type": "string" },
        "situation": { "type": "string" },
        "actualExecution": { "$ref": "#/$defs/executionSide" },
        "optimalExecution": { "$ref": "#/$defs/executionSide" },
        "deltaCost": {
          "type": "object",
          "properties": {
            "time": { "enum": ["low", "medium", "high"] },
            "tokens": { "enum": ["low", "medium", "high"] },
            "operatorFrustration": { "enum": ["low", "medium", "high"] }
          }
        }
      }
    },
    "executionSide": {
      "type": "object",
      "required": ["steps", "outcome"],
      "properties": {
        "steps": { "type": "array", "items": { "type": "string" } },
        "outcome": { "type": "string" },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } },
        "requiredPreflight": { "type": "array", "items": { "type": "string" } }
      }
    },
    "wrongMove": {
      "type": "object",
      "required": ["wrongMoveId", "summary", "whyItWasWrong", "correctFirstMove", "preventiveControl"],
      "properties": {
        "wrongMoveId": { "type": "string" },
        "summary": { "type": "string" },
        "whereItHappened": { "type": "string" },
        "whyItWasWrong": { "type": "string" },
        "correctFirstMove": { "type": "string" },
        "preventiveControl": { "type": "string" },
        "seedTarget": { "type": "string" },
        "executionDeltaId": { "type": "string" }
      }
    },
    "duplicateWork": {
      "type": "object",
      "required": ["duplicateId", "subject", "whyRepeated", "avoidableBy", "recommendedAction"],
      "properties": {
        "duplicateId": { "type": "string" },
        "subject": { "type": "string" },
        "firstKnownInstance": { "type": "string" },
        "priorIndexSlice": { "type": "string" },
        "repeatedInstances": { "type": "array", "items": { "type": "string" } },
        "whyRepeated": { "type": "string" },
        "avoidableBy": { "type": "string" },
        "recommendedAction": {
          "enum": ["dedupe", "canonicalize", "add_guard", "delete_stale_copy", "index"]
        }
      }
    },
    "roiItem": {
      "type": "object",
      "required": ["rank", "title", "whyItPays", "effort", "seedAs"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "whyItPays": { "type": "string" },
        "effort": { "enum": ["low", "medium", "high"] },
        "ownerRepo": { "type": "string" },
        "savedWasteIds": { "type": "array", "items": { "type": "string" } },
        "improvementType": {
          "enum": [
            "retrieval_technique",
            "planning_technique",
            "coding_pattern",
            "debugging_heuristic",
            "validation_rule",
            "operator_preference",
            "tool_order_optimization",
            "stop_condition",
            "prompt_compression",
            "automation_concept"
          ]
        },
        "futureSavings": { "$ref": "#/$defs/futureSavings" },
        "optimalFutureWorkflow": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "seedAs": {
          "enum": ["rule", "runbook", "command", "test", "index-slice", "hook", "owner-artifact"]
        },
        "suggestedWorkPackageId": { "type": "string" }
      }
    },
    "futureSavings": {
      "type": "object",
      "required": [
        "tokenSavingsEstimate",
        "timeSavingsEstimate",
        "toolCallsAvoided",
        "repeatedInvestigationAvoided",
        "implementationReworkAvoided",
        "appliesTo",
        "futureEfficiencyImpact"
      ],
      "properties": {
        "tokenSavingsEstimate": { "enum": ["low", "medium", "high"] },
        "timeSavingsEstimate": { "enum": ["low", "medium", "high"] },
        "toolCallsAvoided": { "type": "integer", "minimum": 0 },
        "repeatedInvestigationAvoided": { "type": "boolean" },
        "implementationReworkAvoided": { "type": "boolean" },
        "appliesTo": {
          "type": "array",
          "items": {
            "enum": [
              "cursor_planning",
              "repository_retrieval",
              "coding",
              "testing",
              "debugging",
              "deployment"
            ]
          },
          "minItems": 1
        },
        "futureEfficiencyImpact": { "type": "string", "minLength": 1 }
      }
    },
    "doNotAdvanceEntry": {
      "type": "object",
      "required": ["awardOrVerdict", "currentStatus", "doNotClaimUntil"],
      "properties": {
        "awardOrVerdict": { "type": "string" },
        "currentStatus": { "enum": ["OPEN", "HOLD", "BLOCKED", "CLOSED"] },
        "doNotClaimUntil": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "lastKnownEvidence": { "type": "array", "items": { "type": "string" } },
        "proofCommandId": { "type": "string" }
      }
    },
    "duplicationCheck": {
      "type": "object",
      "required": ["registryConsulted", "hubSlicesConsulted", "commandIndexConsulted"],
      "properties": {
        "registryConsulted": { "type": "boolean" },
        "hubSlicesConsulted": { "type": "array", "items": { "type": "string" } },
        "commandIndexConsulted": { "type": "boolean" },
        "checkedAt": { "type": "string" }
      }
    }
  }
}
