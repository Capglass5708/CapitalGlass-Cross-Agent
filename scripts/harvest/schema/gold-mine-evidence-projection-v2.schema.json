{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capitalglass.dev/schemas/gold-mine-evidence-projection-v2.json",
  "title": "Gold Mine Evidence Projection v2 (lossless harvest expansion)",
  "description": "P1 expansion projection with extension preservation and future agent instructions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "harvestId", "projections"],
  "properties": {
    "schemaVersion": { "const": "gold-mine-evidence-projection-v2@1.0.0" },
    "harvestId": { "type": "string", "minLength": 1 },
    "sourceCommitSha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "corpusBias": { "$ref": "#/$defs/corpusBias" },
    "productWorkflowCoverage": { "$ref": "#/$defs/productWorkflowCoverage" },
    "futureAgentInstructions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "projections": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/projection" }
    }
  },
  "$defs": {
    "signalClass": {
      "enum": [
        "PROBLEM_SIGNAL",
        "RESOLUTION_SIGNAL",
        "ADOPTION_SIGNAL",
        "PERFORMANCE_SIGNAL",
        "OPERATOR_FRICTION_SIGNAL",
        "AGENT_FRICTION_SIGNAL",
        "OBSERVABILITY_GAP",
        "BUSINESS_WORKFLOW_SIGNAL",
        "SUCCESS_PATTERN"
      ]
    },
    "coverageState": {
      "enum": ["OBSERVED", "NOT_OBSERVED", "UNKNOWN"]
    },
    "projection": {
      "type": "object",
      "additionalProperties": true,
      "required": ["projectionId", "signalClass", "summary", "evidenceRefs"],
      "properties": {
        "projectionId": { "type": "string" },
        "packetId": { "type": "string" },
        "signalClass": { "$ref": "#/$defs/signalClass" },
        "lifecycleHint": { "enum": ["OPEN", "RESOLVED_OBSERVED", "UNKNOWN"] },
        "summary": { "type": "string" },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "extensions": { "type": "object", "additionalProperties": true }
      }
    },
    "productWorkflowCoverage": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/coverageState" }
    },
    "corpusBias": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "evidenceDomainDistribution": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "corpusBiasWarning": { "type": "string" },
        "underObservedDomains": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
