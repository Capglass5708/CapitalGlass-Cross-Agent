{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capitalglass.dev/schemas/cross-agent-harvest-manifest-v1.json",
  "title": "Cross-Agent Harvest Manifest v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "harvestId",
    "missionClass",
    "sourceCommitSha",
    "packets",
    "overallHarvestVerdict"
  ],
  "properties": {
    "schemaVersion": { "const": "cross-agent-harvest-manifest-v1@1.0.0" },
    "harvestId": { "type": "string" },
    "missionClass": { "type": "string" },
    "sourceCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "overallHarvestVerdict": { "type": "string" },
    "packets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "packetId",
          "state",
          "packetVerdict",
          "ownerRepo",
          "ownerIndexingStatus",
          "projectFile",
          "nextAction"
        ]
      }
    }
  }
}
