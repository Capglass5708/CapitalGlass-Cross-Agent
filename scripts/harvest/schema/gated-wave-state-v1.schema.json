{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capitalglass.dev/schemas/gated-wave-state-v1.json",
  "title": "Gated Wave State v1",
  "description": "Machine-readable continuation authority for concept-to-completion waves. Cursor-owned runtime (Phase 6).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "waveId",
    "conceptId",
    "title",
    "phase",
    "gate",
    "state",
    "publication",
    "closeout"
  ],
  "properties": {
    "schemaVersion": { "const": "gated-wave-state-v1@1.0.0" },
    "waveId": { "type": "string", "pattern": "^wave-[0-9]{4}-[0-9]{2}-[0-9]{2}-.+$" },
    "conceptId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string" },
    "phase": {
      "enum": [
        "CONCEPT",
        "DISCOVER",
        "DEFINE",
        "ARCHITECT",
        "PLAN",
        "IMPLEMENT",
        "INTEGRATE",
        "VALIDATE",
        "OPERATOR",
        "DEPLOY",
        "VERIFY",
        "PUBLISH",
        "HARVEST",
        "CLOSE"
      ]
    },
    "gate": { "type": "string", "minLength": 1 },
    "state": {
      "enum": [
        "IN_PROGRESS",
        "BLOCKED",
        "OPERATOR_ACTION_REQUIRED",
        "FAILED",
        "DEFERRED",
        "CLOSED"
      ]
    },
    "completedPhases": { "type": "array", "items": { "type": "string" } },
    "completedSlices": { "type": "array", "items": { "type": "string" } },
    "activeSlice": { "type": "string" },
    "closedLanes": { "type": "array", "items": { "type": "string" } },
    "openLanes": { "type": "array", "items": { "type": "string" } },
    "blockedLanes": { "type": "array", "items": { "type": "string" } },
    "deferredLanes": { "type": "array", "items": { "type": "string" } },
    "repositories": { "type": "array", "items": { "type": "string" } },
    "branches": { "type": "array", "items": { "type": "string" } },
    "commits": { "type": "array", "items": { "type": "string" } },
    "hosts": { "type": "array", "items": { "type": "string" } },
    "owners": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "receipts": { "type": "array", "items": { "type": "string" } },
    "approvals": { "type": "array", "items": { "type": "object" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "resumeAt": { "type": "string" },
    "nextValidAction": { "type": "string" },
    "forbiddenActions": { "type": "array", "items": { "type": "string" } },
    "publication": {
      "type": "object",
      "required": ["git", "hub", "cache", "supabase"],
      "properties": {
        "git": { "enum": ["not-run", "published", "drift", "blocked"] },
        "hub": { "enum": ["not-run", "published", "drift", "blocked"] },
        "cache": { "enum": ["not-run", "published", "drift", "blocked"] },
        "supabase": { "enum": ["not-run", "published", "drift", "blocked"] }
      }
    },
    "closeout": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["OPEN", "WAVE_CLOSED", "BLOCKED"] },
        "deliveredOutcomes": { "type": "array", "items": { "type": "string" } },
        "remainingWork": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
