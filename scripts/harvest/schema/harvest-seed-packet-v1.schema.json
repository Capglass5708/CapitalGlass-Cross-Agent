{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capitalglass.dev/schemas/harvest-seed-packet-v1.json",
  "title": "Harvest Seed Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "seedId",
    "kind",
    "title",
    "summary",
    "retrievalQuestions",
    "evidenceRefs",
    "futureAgentInstructions",
    "ownerRepo",
    "promotionClass",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": "harvest-seed-packet-v1@1.0.0" },
    "seedId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]+$" },
    "kind": {
      "enum": [
        "failure-pattern",
        "runbook",
        "command",
        "architecture",
        "decision",
        "blocker",
        "lesson",
        "roi"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "retrievalQuestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 10 },
      "minItems": 2
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "sourcePacketIds": { "type": "array", "items": { "type": "string" } },
    "executionDeltaRefs": { "type": "array", "items": { "type": "string" } },
    "wasteIds": { "type": "array", "items": { "type": "string" } },
    "operatorFrictionIds": { "type": "array", "items": { "type": "string" } },
    "roiRank": { "type": "integer", "minimum": 1 },
    "futureAgentInstructions": { "$ref": "#/$defs/futureAgentInstructions" },
    "ownerRepo": { "type": "string", "minLength": 1 },
    "targetSlice": { "type": "string" },
    "promotionClass": { "enum": ["AUTOMATIC", "POLICY_GATED", "HUMAN_REVIEW"] },
    "status": { "enum": ["CANDIDATE", "APPROVED", "REJECTED", "QUARANTINED"] }
  },
  "$defs": {
    "futureAgentInstructions": {
      "type": "object",
      "required": ["whenThisAppears", "startAt", "runPreflight", "doNot", "proveBeforeClaiming"],
      "properties": {
        "whenThisAppears": { "type": "string", "minLength": 1 },
        "startAt": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "runPreflight": { "type": "array", "items": { "type": "string" } },
        "doNot": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "proveBeforeClaiming": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    }
  }
}
