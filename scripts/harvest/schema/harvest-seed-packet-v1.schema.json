{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capitalglass.dev/schemas/harvest-seed-packet-v1.json",
  "title": "Harvest Seed Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "seedId",
    "kind",
    "title",
    "summary",
    "retrievalQuestions",
    "evidenceRefs",
    "futureAgentInstructions",
    "ownerRepo",
    "promotionClass",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": "harvest-seed-packet-v1@1.0.0" },
    "seedId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]+$" },
    "kind": {
      "enum": [
        "failure-pattern",
        "runbook",
        "command",
        "architecture",
        "decision",
        "blocker",
        "lesson",
        "roi"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "retrievalQuestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 10 },
      "minItems": 2
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "sourcePacketIds": { "type": "array", "items": { "type": "string" } },
    "executionDeltaRefs": { "type": "array", "items": { "type": "string" } },
    "wasteIds": { "type": "array", "items": { "type": "string" } },
    "operatorFrictionIds": { "type": "array", "items": { "type": "string" } },
    "roiRank": { "type": "integer", "minimum": 1 },
    "improvementType": {
      "enum": [
        "retrieval_technique",
        "planning_technique",
        "coding_pattern",
        "debugging_heuristic",
        "validation_rule",
        "operator_preference",
        "tool_order_optimization",
        "stop_condition",
        "prompt_compression",
        "automation_concept"
      ]
    },
    "futureSavings": { "$ref": "#/$defs/futureSavings" },
    "optimalFutureWorkflow": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "futureAgentInstructions": { "$ref": "#/$defs/futureAgentInstructions" },
    "ownerRepo": { "type": "string", "minLength": 1 },
    "targetSlice": { "type": "string" },
    "promotionClass": { "enum": ["AUTOMATIC", "POLICY_GATED", "HUMAN_REVIEW"] },
    "status": { "enum": ["CANDIDATE", "APPROVED", "REJECTED", "QUARANTINED"] }
  },
  "$defs": {
    "futureSavings": {
      "type": "object",
      "required": [
        "tokenSavingsEstimate",
        "timeSavingsEstimate",
        "toolCallsAvoided",
        "repeatedInvestigationAvoided",
        "implementationReworkAvoided",
        "appliesTo",
        "futureEfficiencyImpact"
      ],
      "properties": {
        "tokenSavingsEstimate": { "enum": ["low", "medium", "high"] },
        "timeSavingsEstimate": { "enum": ["low", "medium", "high"] },
        "toolCallsAvoided": { "type": "integer", "minimum": 0 },
        "repeatedInvestigationAvoided": { "type": "boolean" },
        "implementationReworkAvoided": { "type": "boolean" },
        "appliesTo": {
          "type": "array",
          "items": {
            "enum": [
              "cursor_planning",
              "repository_retrieval",
              "coding",
              "testing",
              "debugging",
              "deployment"
            ]
          },
          "minItems": 1
        },
        "futureEfficiencyImpact": { "type": "string", "minLength": 1 }
      }
    },
    "futureAgentInstructions": {
      "type": "object",
      "required": ["whenThisAppears", "startAt", "runPreflight", "doNot", "proveBeforeClaiming"],
      "properties": {
        "whenThisAppears": { "type": "string", "minLength": 1 },
        "startAt": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "runPreflight": { "type": "array", "items": { "type": "string" } },
        "doNot": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "proveBeforeClaiming": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    }
  }
}
