      "authorityClass": "REGISTRY_AUTHORITY"
    },
    {
      "id": "index-publication",
      "purpose": "Pinned-SHA publication of Cross-Agent state to Intelligence Hub and AI-cache planes using governed worker repos.",
      "entryCommands": ["npm run index:publish"],
      "entryFiles": [
        "scripts/index/run-index-publisher.mjs",
